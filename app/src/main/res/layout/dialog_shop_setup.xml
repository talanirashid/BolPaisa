<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#111B2E"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Shop Setup / Onboarding"
            android:textColor="#F8FAFC"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Configure your Dukaan profile &amp; payment gateway to get started."
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <!-- Logo Preview & Picker -->
        <ImageView
            android:id="@+id/ivShopLogoPreview"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="16dp"
            android:background="#1E293B"
            android:contentDescription="Shop Logo"
            android:padding="8dp"
            android:src="@drawable/logo_mark" />

        <Button
            android:id="@+id/btnSelectLogo"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Select Shop Logo (Optional)"
            android:textAllCaps="false"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Shop Name Input -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Shop / Business Name (Compulsory)"
            android:textColor="#F8FAFC"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etShopName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:background="#1E293B"
            android:hint="e.g. Madina General Store"
            android:inputType="textCapWords"
            android:paddingHorizontal="16dp"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:textSize="15sp" />

        <!-- Primary Gateway Selection -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Primary Payment Gateway"
            android:textColor="#F8FAFC"
            android:textSize="13sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgGateway"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbEasypaisa"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="Easypaisa"
                android:textColor="#F8FAFC"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/rbJazzCash"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="JazzCash"
                android:textColor="#F8FAFC"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/rbRaast"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Raast"
                android:textColor="#F8FAFC"
                android:textSize="12sp" />

        </RadioGroup>

        <!-- Till / Account Number Input -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Till ID / Account Number (Compulsory)"
            android:textColor="#F8FAFC"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etAccountOrTill"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:background="#1E293B"
            android:hint="e.g. 5-digit Till ID or 03336366291"
            android:inputType="number"
            android:paddingHorizontal="16dp"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:textSize="15sp" />

        <!-- Submit Button -->
        <Button
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#10B981"
            android:text="Shuru Karein / Save &amp; Continue"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
