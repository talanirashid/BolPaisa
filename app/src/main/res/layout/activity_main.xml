<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BolPaisa Soundbox"
        android:textColor="@android:color/white"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#1E293B"
        android:padding="16dp"
        android:text="Checking subscription status..."
        android:textColor="#10B981"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnActivate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:backgroundTint="#10B981"
        android:text="Enter Activation Code"
        android:textColor="@android:color/white"
        android:textAllCaps="false"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnWhatsAppSupport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="#25D366"
        android:text="WhatsApp Support (+923336366291)"
        android:textColor="@android:color/white"
        android:textAllCaps="false"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnAbout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="#334155"
        android:text="About &amp; Support (Mehrzaad Technologies)"
        android:textColor="@android:color/white"
        android:textAllCaps="false"
        android:textStyle="bold" />

</LinearLayout>
