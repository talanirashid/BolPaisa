<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Top Header Logo Mark -->
        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="16dp"
            android:contentDescription="BolPaisa Logo"
            android:src="@drawable/logo_mark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Business Setup / دکان سیٹ اپ"
            android:textColor="#F8FAFC"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Set up your store details and primary payment receiving account."
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <!-- Logo Preview & Picker Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#1E293B"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:id="@+id/ivShopLogoPreview"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="#0F172A"
                android:contentDescription="Shop Logo"
                android:padding="8dp"
                android:src="@drawable/logo_mark" />

            <Button
                android:id="@+id/btnSelectLogo"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Select Shop Logo (Optional)"
                android:textAllCaps="false"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Form Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#1E293B"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Shop Name Input -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Shop / Business Name (Compulsory)"
                android:textColor="#F8FAFC"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etShopName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:background="#0F172A"
                android:hint="e.g. Madina General Store"
                android:inputType="textCapWords"
                android:paddingHorizontal="16dp"
                android:textColor="#F8FAFC"
                android:textColorHint="#64748B"
                android:textSize="15sp" />

            <!-- Primary Payment Gateway Selection -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Primary Payment Gateway"
                android:textColor="#F8FAFC"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgGateway"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbEasypaisa"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="Easypaisa"
                    android:textColor="#F8FAFC"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rbJazzCash"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="JazzCash"
                    android:textColor="#F8FAFC"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rbRaast"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Raast"
                    android:textColor="#F8FAFC"
                    android:textSize="13sp" />

            </RadioGroup>

            <!-- Till ID / Account Number Input -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Till ID / Account Number (Compulsory)"
                android:textColor="#F8FAFC"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etAccountOrTill"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:background="#0F172A"
                android:hint="e.g. 5-digit Till ID or 03336366291"
                android:inputType="number"
                android:paddingHorizontal="16dp"
                android:textColor="#F8FAFC"
                android:textColorHint="#64748B"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- Save Button -->
        <Button
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#10B981"
            android:text="Save &amp; Continue to Dashboard"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
