<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Safe Demo Mode"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Top Simulation Banner -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#182436"
        android:gravity="center"
        android:padding="12dp"
        android:text="🛡️ SAFE DEMO MODE - SIMULATION ONLY"
        android:textColor="#38BDF8"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Card 1: Demo Audio Announcement Simulations -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#1E293B"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Simulate Payment Voice Alerts"
            android:textColor="#F8FAFC"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Test payment alerts on counter speakers without altering your real collections or database records."
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnSimulateEasypaisa"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#10B981"
            android:text="Simulate Rs. 150 Easypaisa Alert"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSimulateJazzCash"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#24344B"
            android:text="Simulate Rs. 500 JazzCash Alert"
            android:textAllCaps="false"
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Card 2: Demo PDF Ledger Report -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#1E293B"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Preview Demo PDF Report"
            android:textColor="#F8FAFC"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Generates a sample 3-transaction PDF report watermarked in bold red with 'DEMO - NOT A REAL PAYMENT'."
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnPreviewDemoPdf"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#24344B"
            android:text="Preview Demo PDF Report"
            android:textAllCaps="false"
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Bottom Protection Badge -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="#182436"
        android:gravity="center"
        android:padding="16dp"
        android:text="🛡️ Safe Demo: Zero entries added to your real sales ledger."
        android:textColor="#10B981"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
