<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    android:background="#182436"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Provider Icon / Badge Container -->
    <TextView
        android:id="@+id/tvBadge"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="#202E44"
        android:gravity="center"
        android:text="EP"
        android:textColor="#19C878"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Transaction Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSenderName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gourmet Bakers"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTransactionMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Easypaisa • 06:30 PM"
            android:textColor="#A7B7CD"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Amount & Individual Replay Action -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="+ Rs. 400"
            android:textColor="#19C878"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnReplayItem"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Replay Payment Audio"
            android:src="@drawable/ic_replay"
            android:tint="#19C878" />

    </LinearLayout>

</LinearLayout>
