<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top App Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:src="@android:drawable/ic_menu_revert"
                android:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Customer QR"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Wallet Selector -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Select Receiving Wallet"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/rgWalletSelector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbEasypaisa"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#1E293B"
                android:button="@null"
                android:checked="true"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:text="Easypaisa"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/rbJazzCash"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="#1E293B"
                android:button="@null"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:text="JazzCash"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/rbRaast"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="#1E293B"
                android:button="@null"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:text="Raast"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

        </RadioGroup>

        <!-- Receiving Account Banner -->
        <TextView
            android:id="@+id/tvReceivingAccountBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#1E293B"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="14dp"
            android:text="Receiving on: Easypaisa (03336366291)"
            android:textColor="#10B981"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Amount Input Field -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Enter Payment Amount (Rs.)"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etAmountInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="#1E293B"
            android:hint="Rs. 0.00"
            android:inputType="numberDecimal"
            android:paddingHorizontal="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Generate QR Button -->
        <Button
            android:id="@+id/btnGenerateQr"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#10B981"
            android:text="Generate Customer QR"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Customer-Facing Result Container -->
        <LinearLayout
            android:id="@+id/layoutQrResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#1E293B"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <!-- 1. Shop Name & Amount on TOP above QR -->
            <TextView
                android:id="@+id/tvQrShopName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="MADINA GENERAL STORE"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvQrAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#064E3B"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:text="Rs. 150.00"
                android:textColor="#10B981"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- 2. Center High-Contrast QR Code -->
            <ImageView
                android:id="@+id/ivQrImage"
                android:layout_width="260dp"
                android:layout_height="260dp"
                android:layout_marginTop="16dp"
                android:background="@android:color/white"
                android:contentDescription="Customer Payment QR"
                android:padding="12dp" />

            <!-- 3. Till ID & Instruction BELOW QR -->
            <TextView
                android:id="@+id/tvQrTillId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Till ID / Account: 03336366291 (Easypaisa)"
                android:textColor="#38BDF8"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvQrInstruction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Scan with Easypaisa, JazzCash, or Raast App"
                android:textColor="#94A3B8"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnDoneQr"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#24344B"
                android:text="Done / New Payment"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
