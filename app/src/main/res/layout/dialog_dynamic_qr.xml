<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#111B2E"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dynamic Payment QR"
            android:textColor="#F8FAFC"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Choose receiving wallet and enter amount"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <!-- Gateway Single-Select Chips -->
        <RadioGroup
            android:id="@+id/rgQrGateway"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbChipEasypaisa"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#1E293B"
                android:button="@null"
                android:checked="true"
                android:gravity="center"
                android:paddingVertical="10dp"
                android:text="Easypaisa"
                android:textColor="#F8FAFC"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/rbChipJazzCash"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="#1E293B"
                android:button="@null"
                android:gravity="center"
                android:paddingVertical="10dp"
                android:text="JazzCash"
                android:textColor="#F8FAFC"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/rbChipRaast"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="#1E293B"
                android:button="@null"
                android:gravity="center"
                android:paddingVertical="10dp"
                android:text="Raast"
                android:textColor="#F8FAFC"
                android:textSize="13sp"
                android:textStyle="bold" />

        </RadioGroup>

        <!-- Receiver Info / Tap to Set ID Bar -->
        <TextView
            android:id="@+id/tvReceiverInfoBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#1E293B"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="12dp"
            android:text="Receiving on: Easypaisa (03336366291)"
            android:textColor="#10B981"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etAmount"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="#1E293B"
            android:hint="Rs. 0.00"
            android:inputType="numberDecimal"
            android:paddingHorizontal="16dp"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCancelQr"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#24344B"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="#94A3B8"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnGenerateQr"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#10B981"
                android:text="Generate QR"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

        </LinearLayout>

        <ImageView
            android:id="@+id/ivQrCode"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_marginTop="20dp"
            android:background="@android:color/white"
            android:contentDescription="Payment QR Code"
            android:padding="12dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvQrPayload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>
